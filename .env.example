# Server-only key for the Stock Research Assistant. Never expose it as a VITE_* variable.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the assistant model.
OPENAI_MODEL=gpt-4o-mini
# auto uses OpenAI when available and falls back to the local educational assistant.
ASSISTANT_MODE=auto

# Database Configuration
DATABASE_URL=postgresql://stockuser:stockpass@localhost:5432/stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpass
POSTGRES_DB=stockdb

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Broker API Keys
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_PAPER=true

IBKR_API_KEY=your_ibkr_api_key
IBKR_API_SECRET=your_ibkr_api_secret

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# WebSocket
WS_PORT=8080
WS_RECONNECT_INTERVAL=5000

# Production
NODE_ENV=development
PORT=3000
