# ---- Data provider ----
DATA_PROVIDER=yfinance
STOCK_API_KEY=
# ---- News ----
NEWS_PROVIDER=mock
NEWS_API_KEY=
# ---- Target ----
STOCK_SYMBOL=AAPL
START_DATE=2022-01-01
END_DATE=2026-01-01
# ---- Model ----
LOOKBACK=60
PREDICTION_HORIZON=1
EPOCHS=50
BATCH_SIZE=32
LSTM_UNITS=64
DROPOUT=0.2
LEARNING_RATE=0.001
VALIDATION_SPLIT=0.1
TEST_SPLIT=0.15
USE_SENTIMENT=true
MODEL_DIR=models
# ---- Database (optional; omit to disable persistence) ----
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stockai
LOG_LEVEL=INFO
